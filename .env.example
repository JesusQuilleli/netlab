# =============================================================================
# netlab -- plantilla de configuracion
# =============================================================================
# Copia este archivo como ".env" y rellena los valores reales.
# El archivo ".env" esta en .gitignore y NUNCA debe versionarse.
# En la VPS: chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# SERVIDOR WEB
# -----------------------------------------------------------------------------
# En local y en la VPS: 127.0.0.1, que es lo correcto.
#
# El servidor NO gestiona TLS. Con HOST=0.0.0.0 el puerto de diagnostico queda
# accesible desde Internet y la contrasena viaja en claro. Lo correcto es dejar
# netlab en localhost y poner delante un proxy inverso con HTTPS (nginx, caddy):
#     proxy_pass http://127.0.0.1:4310
HOST=127.0.0.1
PORT=4310

# Cabeceras de proxy inverso (X-Forwarded-For).
#
# Con el despliegue recomendado (nginx/caddy en la misma maquina), la IP real
# del cliente solo viaja en esas cabeceras. 'loopback' es el valor correcto y el
# que viene por defecto: se leen unicamente si quien conecta es esta misma
# maquina, asi que un cliente que llegue directamente desde Internet no puede
# inventarse su IP.
#
# Sin esto, el limite de intentos por IP seria global (un bloqueo por fuerza
# bruta tumbaria el login de todos) y la auditoria guardaria siempre 127.0.0.1.
#
# Valores admitidos: loopback (por defecto) | false | true | <numero de saltos>
TRUST_PROXY=loopback

# -----------------------------------------------------------------------------
# AUTENTICACION
# -----------------------------------------------------------------------------
# En local: false, para no tener que entrar cada vez.
# En la VPS: true, OBLIGATORIO. Con false, cualquiera que llegue al puerto puede
# lanzar diagnosticos.
AUTH_ENABLED=false

# LAS CUENTAS NO ESTAN AQUI.
# Viven en la tabla `usuarios` de data/netlab.db, con la contrasena derivada con
# scrypt. El primer ingreso al sistema pide crear el administrador principal, que
# es despues el que da de alta al resto de usuarios desde /admin. No hace falta
# crear nada por consola.
#
# Las dos variables de abajo ya no las lee nadie: se pueden borrar. Se conservan
# solo para no romper despliegues antiguos.
AUTH_USER=
AUTH_PASSWORD_HASH=

# -----------------------------------------------------------------------------
# ABUSEIPDB  (herramienta: ip-abuse)
# -----------------------------------------------------------------------------
# Credencial expuesta en legacy/Check IP Abuse/abuse/.env -> ROTAR ESTA.
ABUSEIPDB_API_KEY=

# -----------------------------------------------------------------------------
# SPAMHAUS, ZONAS DE PAGO  (herramienta: ip-audit, casilla "Verificar en las
# zonas de pago de Spamhaus")
# -----------------------------------------------------------------------------
# Opcional. Sin esto, netlab sigue funcionando: lo dira en el informe.
#
# DONDE SE PIDE. Alta gratuita:
#   https://portal.spamhaus.com/auth/account-setup?ps=free_dqs_product
# Spamhaus lo llama "Blocklists via DNS Query" (antes DQS). Es solo para no
# comerciales y con un volumen bajo de consultas; las tecnicas no dan soporte.
#
# QUE HACE. Las zonas publicas (zen.spamhaus.org y demas) solo dan datos a un
# resolvedor que Spamhaus tenga registrado. Al resto le devuelven NXDOMAIN, que
# es justo lo mismo que devuelve una IP que no esta listada, asi que desde un
# servidor no se puede distinguir una cosa de la otra. Con clave, la consulta va
# a las zonas de pago, que contestan a cualquiera porque el acceso va en el
# NOMBRE de la zona: "<clave>.zen.dq.spamhaus.net". Ojo al .net.
#
# QUE ZONAS DA. zen, sbl, xbl, sbl-xbl, pbl y authbl. El codigo de respuesta dice
# en que sublista esta (127.0.0.2 = SBL, 127.0.0.4 = XBL, 127.0.0.10 = PBL).
#
# LO QUE NO DA, Y AVISO PORQUE ES IMPORTANTE. BCL, la Botnet Controller List, la
# lista de IPs que controlan bots, NO esta en las zonas de pago: ni en el pack
# gratuito ni en el comercial. Solo existe en las zonas publicas, o sea, solo
# para resolvedores registrados. La clave gratuita NO resuelve el caso de botnet
# C&C. Lo que si hay de botnet en el pack gratuito es para DOMINIOS (el codigo
# 2006 de DBL), que es otra cosa: un dominio que es un C2, no una IP que lo
# aloja. Para el dato de BCL por IP, consultar https://check.spamhaus.org.
#
# ESTA variable se enmascara sola al mostrarse: el nombre contiene KEY y
# config/redact la cubre.
SPAMHAUS_DQS_KEY=

# -----------------------------------------------------------------------------
# PERFILES DE CORREO  -- NO LOS USA smtp-validator
# -----------------------------------------------------------------------------
# AVISO IMPORTANTE: la herramienta smtp-validator NO lee nada de esta seccion.
# El formulario empieza vacio y quien hace la prueba escribe el host, el puerto,
# el usuario y la contrasena. Lo que escribas aqui no se precarga ni se guarda.
#
# Por que se dejan los huecos, entonces: para las pruebas manuales por linea de
# comandos y para los scripts de src/core/mail, que si los reciben por argumento.
# Una herramienta web que rellenara sola un usuario y una contrasena acabaria
# metiendolos en el historial de quien la usa, y ese historial es un fichero en
# disco.
#
# Si algun dia se decide lo contrario, seria un cambio conscious: habria que
# guardar el perfil NOMBRE en la base de datos (nunca los valores) y avisar en la
# interfaz de que se van a usar credenciales guardadas por otro.
#
# Un perfil por cada buzon que quieras usar a mano, con
# NETLAB_MAIL_<NOMBRE>_HOST / _PORT / _SECURE / _USER / _PASS
# (+ _IMAP_PORT si tambien quieres probar IMAP).
#
# Hay DOS perfiles distintos y no se deben mezclar. En legacy/ estaban escritos
# en scripts separados y confundirlos producia un host con la contrasena de
# otro, que es un error de autenticacion que no dice nada util.
#
# Perfil "buzon" -- buzon propio, con IMAP y SMTP propios:
#   NETLAB_MAIL_BUZON_HOST=smtp.ejemplo.com
#   NETLAB_MAIL_BUZON_PORT=465
#   NETLAB_MAIL_BUZON_SECURE=true
#   NETLAB_MAIL_BUZON_IMAP_PORT=993
#   NETLAB_MAIL_BUZON_USER=buzon@ejemplo.com
#   NETLAB_MAIL_BUZON_PASS=
#
# Perfil "salida" -- envio en nombre de un dominio,via el proveedor:
#   NETLAB_MAIL_SALIDA_HOST=smtp.proveedor.com
#   NETLAB_MAIL_SALIDA_PORT=465
#   NETLAB_MAIL_SALIDA_SECURE=true
#   NETLAB_MAIL_SALIDA_USER=
#   NETLAB_MAIL_SALIDA_PASS=
#
# OJO: hay proveedores cuyo usuario tiene forma de clave de AWS (AKIA...) y NO
# es una clave de AWS. No las pases por AWS_ACCESS_KEY_ID.
#
# Para traerme las de legacy/ al .env local:
#   node scripts/importar-legacy.js
NETLAB_MAIL_BUZON_HOST=
NETLAB_MAIL_BUZON_PORT=
NETLAB_MAIL_BUZON_SECURE=
NETLAB_MAIL_BUZON_IMAP_PORT=
NETLAB_MAIL_BUZON_USER=
NETLAB_MAIL_BUZON_PASS=

NETLAB_MAIL_SALIDA_HOST=
NETLAB_MAIL_SALIDA_PORT=
NETLAB_MAIL_SALIDA_SECURE=
NETLAB_MAIL_SALIDA_USER=
NETLAB_MAIL_SALIDA_PASS=

# Remitente y destinatario por defecto de los scripts de linea de comandos.
# smtp-validator tambien los ignora: escribe el destinatario en el formulario
# cada vez, a proposito, porque enviar es una decision de cada intento.
REMITENTE_POR_DEFECTO=
DESTINO_POR_DEFECTO=

# -----------------------------------------------------------------------------
# IDENTIDAD DE LOS REPORTES
# -----------------------------------------------------------------------------
# Aparece en la cabecera y el pie de los PDF.
REPORT_BRAND=netlab
REPORT_FOOTER=Documento generado automaticamente por netlab